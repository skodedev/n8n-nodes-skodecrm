{
  "name": "n8n-nodes-skodecrm",
  "version": "0.1.2",
  "description": "n8n community node for Skode CRM — manage leads and trigger on lead events.",
  "keywords": [
    "n8n-community-node-package",
    "skode",
    "crm",
    "leads"
  ],
  "license": "MIT",
  "homepage": "https://skode.ai",
  "author": {
    "name": "Skode Technologies Pvt Ltd",
    "email": "info@skode.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skodedev/n8n-nodes-skodecrm.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SkodeCrmOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SkodeCrm/SkodeCrm.node.js",
      "dist/nodes/SkodeCrm/SkodeCrmTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "n8n-workflow": "*",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0"
  }
}
